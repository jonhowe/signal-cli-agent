rules:
  - name: home_dir_list
    sender:
      - "@PHONE@"
    trigger: "home directory?"
    match: exact
    command: ["ls", "-lah", "/home/@USER@"]
    cooldown_sec: 5
    max_runs_per_hour: 60
    split_reply: true
    chunk_size: 1400
    numbered_chunks: true
    # default reply_mode is "full" (shows exit + command + output)

  - name: journal_tail
    sender:
      - "@PHONE@"
    match: regex
    trigger: "^tail journal (\\d+)$"
    command_template: ["journalctl", "-n", "{n}", "--no-pager"]
    args:
      n:
        type: int
        min: 1
        max: 200
    timeout_sec: 8
    split_reply: true
    chunk_size: 1400
    numbered_chunks: true

  - name: disk_usage
    sender:
      - "@PHONE@"
    trigger: "disk?"
    match: exact
    command: ["df", "-h"]
    reply_to: admin
    split_reply: true
    chunk_size: 1400
    numbered_chunks: true

  # Example showing "output"-only reply mode (no exit code, no command)
  - name: uptime
    sender:
      - "@PHONE@"
    trigger: "uptime?"
    match: exact
    command: ["uptime"]
    reply_mode: output
    split_reply: false

  # --- Plugin example (Phase 1): HTTP GET ---
  # This is intentionally generic and safe.
  #
  # Before using HTTP plugins, consider setting globals.plugin_http.allowed_hosts
  # in rules.yaml.in (rendered to rules.yaml) to restrict which hosts can be queried.
  #
  # - name: local_health
  #   sender:
  #     - "@PHONE@"
  #   trigger: "health?"
  #   match: exact
  #   reply_mode: output
  #   type: http_get
  #   http_get:
  #     url: "http://127.0.0.1:8080/health"
  #     label: "health"
