rules:
  # ----------------------------
  # Shipped example rules
  # ----------------------------
  #
  # These are intentionally *generic* and safe-ish examples.
  #
  # NOTE:
  # - In Docker deployments, /config and /data are common bind mounts.
  # - In non-container deployments, those paths may not exist — the examples
  #   below will fall back gracefully.

  - name: list_config
    sender:
      - "@PHONE@"
    trigger: "config?"
    match: exact
    command: ["sh", "-lc", "if [ -d /config ]; then ls -lah /config; else echo '/config not present'; fi"]
    cooldown_sec: 5
    max_runs_per_hour: 60
    split_reply: true
    chunk_size: 1400
    numbered_chunks: true
    reply_mode: output

  - name: list_data
    sender:
      - "@PHONE@"
    trigger: "data?"
    match: exact
    command: ["sh", "-lc", "if [ -d /data ]; then ls -lah /data; else echo '/data not present'; fi"]
    cooldown_sec: 5
    max_runs_per_hour: 60
    split_reply: true
    chunk_size: 1400
    numbered_chunks: true
    reply_mode: output

  - name: disk_usage
    sender:
      - "@PHONE@"
    trigger: "disk?"
    match: exact
    command: ["df", "-h"]
    reply_to: admin
    split_reply: true
    chunk_size: 1400
    numbered_chunks: true

  # Example showing "output"-only reply mode (no exit code, no command)
  - name: uptime
    sender:
      - "@PHONE@"
    trigger: "uptime?"
    match: exact
    command: ["uptime"]
    reply_mode: output
    split_reply: false

  # --- Plugin example (Phase 1): HTTP GET ---
  # This is intentionally generic and safe.
  #
  # Before using HTTP plugins, consider setting globals.plugin_http.allowed_hosts
  # in rules.yaml (rendered from rules.yaml.in) to restrict which hosts can be queried.
  #
  # - name: local_health
  #   sender:
  #     - "@PHONE@"
  #   trigger: "health?"
  #   match: exact
  #   reply_mode: output
  #   type: http_get
  #   http_get:
  #     url: "http://127.0.0.1:8080/health"
  #     label: "health"
