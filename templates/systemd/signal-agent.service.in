[Unit]
Description=Signal CLI Agent (rules engine)
After=signal-cli-dbus.service
Wants=signal-cli-dbus.service

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@PYTHON@ @AGENT_SCRIPT@ @RULES_YAML@
Restart=on-failure
RestartSec=3

# Helps avoid "TERM" killing issues (GLib main loop)
KillSignal=SIGINT
TimeoutStopSec=10

# Optional hardening (safe defaults)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target