globals:
  # --- Core safety defaults ---
  deny_groups: true

  default_timeout_sec: 5
  default_max_reply_chars: 3500
  default_split_reply: false
  default_chunk_size: 1500

  numbered_chunks: false

  default_match: exact
  default_case_sensitive: false

  default_cooldown_sec: 2
  default_max_runs_per_hour: 30

  reply_prefix: ""
  reply_suffix: ""
  default_reply_to: sender

  # NOTE: configure.py injects @PHONE@ here.
  admin: "@PHONE@"

  redact_regex:
    - "(?i)api[_-]?key\\s*[:=]\\s*\\S+"
    - "(?i)token\\s*[:=]\\s*\\S+"
    - "(?i)password\\s*[:=]\\s*\\S+"

  # --- Plugins: shared HTTP safety defaults (Phase 1) ---
  # These apply to plugins that make HTTP requests (home_assistant, http_get, ...)
  #
  # Recommended:
  # - Set allowed_hosts to the specific host(s) your plugins may contact.
  # - Keep max_response_bytes modest unless you explicitly need larger responses.
  plugin_http:
    allowed_schemes: ["http", "https"]
    allowed_hosts: []          # e.g. ["homeassistant.home.lan", "homeassistant.home.lan:8123"]
    follow_redirects: true     # redirects are validated against allowed_hosts
    max_response_bytes: 262144 # 256 KiB

  # --- Plugin: Home Assistant (optional global defaults) ---
  # home_assistant:
  #   url: "http://homeassistant.home.lan:8123"
  #   token_file: "~/.config/signal-cli-agent/ha_token"
  #   timeout_sec: 4
  #   require_private_token_file: true

# NEW: all rules are loaded from here (in addition to any rules in this file)
rules_dir: "@REPO@/rules.d"
